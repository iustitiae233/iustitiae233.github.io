---
import BaseLayout from "./BaseLayout.astro";
import PrevNext from "../components/PrevNext.astro";
import Toc from "../components/Toc.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import CopyCode from "../components/CopyCode.astro";
import "../styles/prose.css";
import { formatDate } from "../lib/format";
import { estimateReadingTime } from "../lib/reading-time";
import type { ContentEntryLike } from "../lib/posts";

interface Props {
  /** 文章与笔记共用（结构类型，见 lib/posts.ts） */
  post: ContentEntryLike;
  headings: { depth: number; slug: string; text: string }[];
  newer: { id: string; data: { title: string } } | null;
  older: { id: string; data: { title: string } } | null;
  /** 上一篇/下一篇链接前缀：文章 "/posts/"（默认），笔记 "/notes/" */
  basePath?: string;
}
const { post, headings, newer, older, basePath } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
const reading = estimateReadingTime(post.body ?? "");
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>发布于 {formatDate(pubDate)}</time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>更新于 {formatDate(updatedDate)}</time>
        )}
        <span>{reading.label}阅读</span>
      </p>
    </header>

    {heroImage && (
      <img
        class="hero-img"
        src={heroImage}
        alt=""
        width="1200"
        height="630"
        loading="eager"
        decoding="async"
      />
    )}

    <div class="post-body">
      <div class="post-content">
        <slot />
      </div>
      <Toc headings={headings} />
    </div>
  </article>
  <PrevNext
    newer={newer ? { slug: newer.id, title: newer.data.title } : null}
    older={older ? { slug: older.id, title: older.data.title } : null}
    basePath={basePath}
  />
  <CopyCode />

  <dialog id="lightbox" class="lightbox">
    <img alt="" src="" />
  </dialog>
  <script>
    // 灯箱与正文图片都是每页新 DOM —— 软导航后重新挂载（与 CopyCode 同款约定）
    function initLightbox() {
      const lb = document.getElementById("lightbox") as HTMLDialogElement | null;
      const lbImg = lb?.querySelector("img") ?? null;
      if (!lb || !lbImg) return;
      if (!lb.dataset.closeBound) {
        lb.dataset.closeBound = "1";
        lb.addEventListener("click", (e) => {
          if (e.target === lb || e.target === lbImg) lb.close();
        });
      }
      for (const img of document.querySelectorAll<HTMLImageElement>(".post-content img")) {
        if (img.dataset.lightboxBound) continue;
        img.dataset.lightboxBound = "1";
        img.addEventListener("click", () => {
          lbImg.src = img.currentSrc || img.src;
          lbImg.alt = img.alt;
          lb.showModal();
        });
      }
    }

    initLightbox();
    document.addEventListener("astro:page-load", initLightbox);
  </script>
</BaseLayout>

<style>
  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-3);
    font-size: 0.85rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 3rem;
  }
  @media (max-width: 1279px) {
    .post-body { grid-template-columns: 1fr; }
  }
</style>

<style>
  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 92vw;
    max-height: 92vh;
  }
  .lightbox::backdrop {
    background: rgba(4, 6, 12, 0.85);
    backdrop-filter: blur(8px);
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 92vh;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
  }
</style>
