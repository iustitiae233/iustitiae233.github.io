---
// 番茄钟：顶栏胶囊入口 + 锚定 popover 面板。零岛屿，脚本沿用 Search.astro 模式
// （document 事件委托 + 动态查 DOM + astro:page-load 重同步）。
// 计时状态在模块作用域 —— ClientRouter 不重执行已加载模块，软导航下存活；
// localStorage write-through 让硬刷新/关标签页后按墙钟结算恢复。
---

<div class="pomo-wrap">
  <button
    id="pomodoro-pill"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="番茄钟"
    data-pomodoro-open
  >
    <svg class="pomo-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="13" r="8" />
      <path d="M12 9v4l2.5 2.5M9 2h6" />
    </svg>
    <span class="pomo-label">番茄钟</span>
    <span class="pomo-time" hidden>25:00</span>
  </button>

  <div id="pomodoro-panel" class="pomo-panel" hidden role="dialog" aria-label="番茄钟">
    <div class="pomo-ring-row">
      <svg width="140" height="140" viewBox="0 0 140 140" aria-hidden="true">
        <circle class="ring-track" cx="70" cy="70" r="54" />
        <circle class="ring-bar" data-pomo-ring cx="70" cy="70" r="54" />
      </svg>
      <div class="pomo-center">
        <span class="pomo-big" data-pomo-time>25:00</span>
        <span class="pomo-phase" data-pomo-phase-label>专注</span>
      </div>
    </div>
    <div class="pomo-dots" aria-hidden="true">
      <span class="dot" data-pomo-dot></span><span class="dot" data-pomo-dot></span><span class="dot" data-pomo-dot></span><span class="dot" data-pomo-dot></span>
    </div>
    <div class="pomo-actions">
      <button type="button" class="pomo-btn primary" data-pomo-start>开始</button>
      <button type="button" class="pomo-btn" data-pomo-skip>跳过</button>
      <button type="button" class="pomo-btn" data-pomo-reset>重置</button>
    </div>
    <p class="sr-only" aria-live="polite" data-pomo-live></p>
  </div>
</div>

<style>
  /* 胶囊 —— 与 Topbar .search-entry 同款语言；wrap 承担右推 + 面板锚定 */
  .pomo-wrap {
    position: relative;
    margin-left: auto; /* 自身 + 后续搜索胶囊一起推到右侧（搜索的 margin-left:auto 已移除） */
  }
  #pomodoro-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-3);
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  #pomodoro-pill:hover { color: var(--text-2); border-color: var(--border-strong); }
  #pomodoro-pill svg[hidden] { display: none; } /* svg 上 hidden 属性的显式兜底 */
  .pomo-time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    min-width: 5ch; /* 闲置 ↔ 计时切换不抖布局 */
  }

  /* 运行态：进度底色填充（--p 由脚本更新），专注=青 / 休息=紫 */
  #pomodoro-pill[data-state="running"] { color: var(--text-1); }
  #pomodoro-pill[data-state="running"][data-phase="focus"] {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--accent) 20%, transparent) calc(var(--p, 0) * 100%),
      transparent calc(var(--p, 0) * 100%));
  }
  #pomodoro-pill[data-state="running"][data-phase="short"],
  #pomodoro-pill[data-state="running"][data-phase="long"] {
    border-color: color-mix(in srgb, var(--accent-2) 45%, transparent);
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--accent-2) 20%, transparent) calc(var(--p, 0) * 100%),
      transparent calc(var(--p, 0) * 100%));
  }
  #pomodoro-pill[data-state="paused"] { opacity: 0.6; }

  /* 阶段结束待确认：呼吸光晕（无声提示的视觉补强） */
  #pomodoro-pill[data-state="awaiting"] { color: var(--text-1); }
  #pomodoro-pill[data-state="awaiting"][data-phase="focus"] {
    animation: pomo-breathe-cyan 2s var(--ease-out) infinite;
  }
  #pomodoro-pill[data-state="awaiting"][data-phase="short"],
  #pomodoro-pill[data-state="awaiting"][data-phase="long"] {
    animation: pomo-breathe-purple 2s var(--ease-out) infinite;
  }
  @keyframes pomo-breathe-cyan {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 18px 2px var(--accent-glow); }
  }
  @keyframes pomo-breathe-purple {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 18px 2px var(--accent-2-glow); }
  }

  /* 面板：锚定胶囊下方。z-90 在 topbar(z-30) 上下文内，搜索 modal(z-100, body 级) 仍盖其上 */
  .pomo-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 90;
    width: 300px;
    padding: 1.25rem;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 24px 80px -20px rgba(0, 0, 0, 0.6), 0 0 60px -30px var(--accent-glow);
    animation: pomo-panel-in 220ms var(--ease-out);
  }
  .pomo-panel[hidden] { display: none; }
  @keyframes pomo-panel-in {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
  }

  .pomo-ring-row { position: relative; }
  .ring-track, .ring-bar { fill: none; stroke-width: 6; }
  .ring-track { stroke: var(--border); }
  .ring-bar {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 339.292; /* 2π×54 */
    stroke-dashoffset: 0; /* JS 按 剩余/满时长 更新 */
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 0.4s linear;
  }
  .pomo-panel[data-phase="short"] .ring-bar,
  .pomo-panel[data-phase="long"] .ring-bar { stroke: var(--accent-2); }

  .pomo-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.1rem;
  }
  .pomo-big {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-1);
  }
  .pomo-phase { font-size: 0.8rem; color: var(--text-3); letter-spacing: 0.1em; }

  .pomo-dots { display: flex; gap: 0.5rem; }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    transition: background-color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .dot.fill { background: var(--accent); border-color: var(--accent); }

  .pomo-actions { display: flex; gap: 0.5rem; }
  .pomo-btn {
    padding: 0.45rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-2);
    font-size: 0.85rem;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .pomo-btn:hover { color: var(--text-1); border-color: var(--border-strong); }
  .pomo-btn.primary {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
  }
  .pomo-btn.primary:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* 移动端：胶囊收成纯图标 / 纯时间 */
  @media (max-width: 767px) {
    .pomo-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #pomodoro-pill[data-state="awaiting"] { animation: none; }
    .pomo-panel { animation: none; }
    .ring-bar { transition: none; }
  }
</style>

<script>
  import {
    advance,
    defaultState,
    formatMs,
    fullMs,
    parse,
    pause,
    remainingOf,
    reset,
    serialize,
    settleExpired,
    skip,
    start,
    type Phase,
    type PomodoroState,
  } from "../lib/pomodoro";

  const KEY = "pomodoro";
  const PHASE_LABEL: Record<Phase, string> = { focus: "专注", short: "短休", long: "长休" };
  const RING_C = 2 * Math.PI * 54;

  // 模块作用域状态：软导航下存活（ClientRouter 不重执行已加载模块）。
  // DOM 引用绝不缓存在顶层 —— body 每次导航被替换（Search.astro 已注释的坑）。
  let state: PomodoroState;
  try {
    state = settleExpired(parse(localStorage.getItem(KEY)), Date.now());
  } catch {
    state = defaultState(); // 隐身模式等 localStorage 不可用：纯内存态
  }

  let ticker: ReturnType<typeof setInterval> | null = null;
  let baseTitle = document.title;
  let lastTitle = document.title;

  const getPill = () => document.getElementById("pomodoro-pill");
  const getPanel = () => document.getElementById("pomodoro-panel");

  type PillState = "idle" | "running" | "paused" | "awaiting";
  function pillStateOf(s: PomodoroState): PillState {
    if (s.awaiting) return "awaiting";
    if (s.running) return "running";
    if (s.remainingMs < fullMs(s.phase)) return "paused";
    return "idle";
  }

  function syncTitle(st: PillState, ms: number) {
    let t = baseTitle;
    if (st === "running") t = `${formatMs(ms)} ${PHASE_LABEL[state.phase]} · ${baseTitle}`;
    else if (st === "awaiting") {
      t = `${state.phase === "focus" ? "🍅 该专注了" : "☕ 该休息了"} · ${baseTitle}`;
    }
    if (t !== lastTitle) {
      document.title = t;
      lastTitle = t;
    }
  }

  function renderPanel(ms: number) {
    const panel = getPanel();
    if (!panel) return;
    panel.dataset.phase = state.phase;
    const big = panel.querySelector<HTMLElement>("[data-pomo-time]");
    if (big) big.textContent = formatMs(ms);
    const phaseLabel = panel.querySelector<HTMLElement>("[data-pomo-phase-label]");
    if (phaseLabel) phaseLabel.textContent = PHASE_LABEL[state.phase];
    const ring = panel.querySelector<SVGCircleElement>("[data-pomo-ring]");
    if (ring) ring.style.strokeDashoffset = String(RING_C * (ms / fullMs(state.phase)));
    const dots = panel.querySelectorAll<HTMLElement>("[data-pomo-dot]");
    const filled = state.completedFocus % 4;
    dots.forEach((d, i) => d.classList.toggle("fill", i < filled));
    const startBtn = panel.querySelector<HTMLButtonElement>("[data-pomo-start]");
    if (startBtn) startBtn.textContent = state.running ? "暂停" : "开始";
  }

  function render(now = Date.now()) {
    // 自然结束检测在渲染统一结算（tick 或后台唤醒都会走到这里）
    if (state.running && state.endsAt !== null && now >= state.endsAt) {
      const done = state.phase;
      commit(
        advance(state),
        `${PHASE_LABEL[done]}完成，${done === "focus" ? "该休息了" : "该专注了"}`,
      );
      return;
    }
    const pill = getPill();
    if (!pill) return; // 极端时序：新页 DOM 未就绪，下个 tick 自愈
    const ms = remainingOf(state, now);
    const st = pillStateOf(state);
    pill.dataset.state = st;
    pill.dataset.phase = state.phase;
    pill.style.setProperty("--p", String(1 - ms / fullMs(state.phase)));
    const showTime = st !== "idle";
    // toggleAttribute 而非 .hidden 属性赋值 —— svg 上 hidden 是 HTMLElement 的
    // 反射属性，SVGElement 赋值只写 expando 不落 attribute，CSS 选择器永不命中
    pill.querySelector(".pomo-icon")?.toggleAttribute("hidden", showTime);
    pill.querySelector(".pomo-label")?.toggleAttribute("hidden", showTime);
    const time = pill.querySelector<HTMLElement>(".pomo-time");
    if (time) {
      time.textContent = formatMs(ms);
      time.toggleAttribute("hidden", !showTime);
    }
    const panel = getPanel();
    if (panel && !panel.hasAttribute("hidden")) renderPanel(ms);
    syncTitle(st, ms);
  }

  function persist() {
    try {
      localStorage.setItem(KEY, serialize(state));
    } catch {
      /* 隐身模式：跳过持久化，纯内存态 */
    }
  }

  // 唯一常驻开销：running 时 500ms tick；暂停/闲置零定时器
  function ensureTicker() {
    if (state.running && ticker === null) ticker = setInterval(render, 500);
    else if (!state.running && ticker !== null) {
      clearInterval(ticker);
      ticker = null;
    }
  }

  function commit(next: PomodoroState, announce?: string) {
    state = next;
    persist();
    ensureTicker();
    render();
    if (announce) {
      const live = document.querySelector<HTMLElement>("[data-pomo-live]");
      if (live) live.textContent = announce;
    }
  }

  function openPanel() {
    const panel = getPanel();
    if (!panel) return;
    panel.removeAttribute("hidden");
    getPill()?.setAttribute("aria-expanded", "true");
    render();
    panel.querySelector<HTMLButtonElement>("[data-pomo-start]")?.focus();
  }
  function closePanel() {
    getPanel()?.setAttribute("hidden", "");
    const pill = getPill();
    pill?.setAttribute("aria-expanded", "false");
    pill?.focus();
  }

  // —— 事件全部委托到 document：软导航后按钮是新 DOM（同 Search/MenuButton 模式）——
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-pomodoro-open]")) {
      if (getPanel()?.hasAttribute("hidden")) openPanel();
      else closePanel();
      return;
    }
    const panel = getPanel();
    if (!panel || panel.hasAttribute("hidden")) return;
    if (t.closest("[data-pomo-start]")) {
      commit(state.running ? pause(state, Date.now()) : start(state, Date.now()));
      return;
    }
    if (t.closest("[data-pomo-skip]")) {
      commit(skip(state));
      return;
    }
    if (t.closest("[data-pomo-reset]")) {
      commit(reset(state));
      return;
    }
    if (!panel.contains(t)) closePanel(); // 点面板外关闭
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const panel = getPanel();
      if (panel && !panel.hasAttribute("hidden")) closePanel();
    }
  });

  // 软导航：标题被新页重置、胶囊是新 DOM —— 重新同步（模块状态不动，计时不断）
  function onPageLoad() {
    baseTitle = document.title;
    lastTitle = document.title;
    render();
    ensureTicker();
  }
  onPageLoad();
  document.addEventListener("astro:page-load", onPageLoad);

  // 后台标签页 setInterval 被节流：回到前台立即按墙钟重算
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) render();
  });
</script>
