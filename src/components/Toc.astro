---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 0 && (
  <nav class="toc" aria-label="本页大纲">
    <p class="toc-title">大纲</p>
    <span class="toc-indicator" aria-hidden="true"></span>
    <ul>
      {toc.map((h) => (
        <li class:list={["toc-item", `d${h.depth}`]}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 4.5rem;
    align-self: start;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    font-size: 0.83rem;
  }
  .toc-title {
    color: var(--text-3);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  /* 滑动指示条：定位由脚本测量 active 链接后写入 transform/height */
  .toc-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0;
    transition: transform 250ms var(--ease-out), height 250ms var(--ease-out),
      opacity var(--t-fast) var(--ease-out);
  }
  ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  .toc-item a {
    display: block;
    padding: 0.3rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--text-3);
    line-height: 1.5;
    transition: color var(--t-fast) var(--ease-out);
  }
  .toc-item.d3 { padding-left: 0.75rem; font-size: 0.78rem; }
  .toc-item a:hover { color: var(--text-1); }
  .toc-item a.active { color: var(--accent); }
  @media (max-width: 1279px) {
    .toc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-indicator { transition: none; }
  }
</style>

<script>
  // 文章间软导航后标题与 TOC 链接都是新 DOM —— astro:page-load 时重建观察
  let links: HTMLAnchorElement[] = [];
  let observer: IntersectionObserver | null = null;

  // 把指示条平移到 active 链接的位置（offsetParent 都是 .toc，坐标系一致）
  function moveIndicator() {
    const ind = document.querySelector<HTMLElement>(".toc-indicator");
    if (!ind) return;
    const active = links.find((a) => a.classList.contains("active"));
    if (!active) {
      ind.style.opacity = "0";
      return;
    }
    ind.style.transform = `translateY(${active.offsetTop}px)`;
    ind.style.height = `${active.offsetHeight}px`;
    ind.style.opacity = "1";
  }

  function initToc() {
    observer?.disconnect();
    links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-item a"),
    );
    const setActive = (id: string) => {
      for (const a of links) a.classList.toggle("active", a.getAttribute("href") === `#${id}`);
      moveIndicator();
    };
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-15% 0px -70% 0px" },
    );
    for (const a of links) {
      const id = a.getAttribute("href")?.slice(1);
      const el = id ? document.getElementById(id) : null;
      if (el) observer.observe(el);
    }
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>
