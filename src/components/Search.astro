---
import type { SearchEntry } from "../lib/search";

interface Props {
  entries: SearchEntry[];
}
const { entries } = Astro.props;

// 索引随页面 HTML 内联。用 set:html 绕过表达式转义 —— <script> 是原始文本
// 元素，实体不解码，转义后的 &quot; 会让 JSON.parse 失败。replace 把 <
// 写成 JSON 转义序列（backslash-u003c），防止标题里出现 </script> 逃逸。
const indexJson = JSON.stringify(entries).replace(/</g, "\\u003c");
---

<div
  id="search-modal"
  class="search-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="搜索"
>
  <div class="search-panel" data-panel>
    <div class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="搜索标题与正文…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>Esc</kbd>
    </div>
    <ul id="search-results" class="search-results" role="listbox"></ul>
    <p class="search-hint">↑↓ 选择 · Enter 打开 · Esc 关闭</p>
  </div>
</div>

<script type="application/json" id="search-index" set:html={indexJson} />

<style>
  /* hidden 属性移除（display none→grid）时动画重放 —— 即每次打开弹入一次 */
  @keyframes modal-in {
    from { opacity: 0; }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
  }
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: start center;
    padding-top: 12vh;
    background: color-mix(in srgb, #05070d 65%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: modal-in 150ms var(--ease-out);
  }
  .search-modal[hidden] { display: none; }
  .search-panel {
    animation: panel-in 220ms var(--ease-spring);
    width: min(640px, 92vw);
    display: grid;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 24px 80px -20px rgba(0, 0, 0, 0.6), 0 0 60px -30px var(--accent-glow);
    overflow: hidden;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
  }
  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-1);
    font-size: 1.05rem;
    outline: none;
    font-family: inherit;
  }
  .search-box input::placeholder { color: var(--text-3); }
  .search-box kbd {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.7rem;
    color: var(--text-3);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    max-height: 50vh;
    overflow-y: auto;
    display: grid;
    gap: 2px;
  }
  .search-results:empty { padding: 0.75rem; }
  .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .result.selected { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .result .r-title {
    color: var(--text-1);
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .result .r-snippet {
    grid-column: 1 / -1;
    color: var(--text-3);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .result .r-snippet :global(mark) { color: var(--accent); background: none; }
  .result .r-title :global(mark) { color: var(--accent); background: none; }
  .result .r-kind {
    flex: none;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-3);
    font-size: 0.7rem;
  }
  .search-hint {
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .search-modal,
    .search-panel {
      animation: none;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    filterEntries,
    filterEntriesFullText,
    type FullTextEntry,
    type FullTextResult,
    type SearchEntry,
  } from "../lib/search";

  // 不能在模块顶层缓存 DOM 引用或索引 —— ClientRouter 软导航会替换 body，
  // 闭包里的引用会变成已移除的旧节点（索引 script 标签同理，随页面重建）。
  const getModal = () => document.getElementById("search-modal");
  const getInput = () => document.getElementById("search-input") as HTMLInputElement | null;
  const getResultsEl = () => document.getElementById("search-results");

  const readIndex = (): SearchEntry[] => {
    try {
      const el = document.getElementById("search-index");
      return el ? (JSON.parse(el.textContent ?? "[]") as SearchEntry[]) : [];
    } catch {
      return [];
    }
  };

  // 全文索引按需加载：模块级 promise 缓存（软导航间存活），失败静默降级为标题搜索。
  // open() 时预热，用户敲键时大概率已就绪；多次输入 await 同一 promise 无竞态。
  let fullIndexPromise: Promise<FullTextEntry[]> | null = null;
  const ensureFullIndex = () => {
    fullIndexPromise ??= fetch("/search-index.json")
      .then((r) => (r.ok ? (r.json() as Promise<FullTextEntry[]>) : Promise.reject(r.status)))
      .catch(() => [] as FullTextEntry[]);
    return fullIndexPromise;
  };

  let results: FullTextResult[] = [];
  let selected = 0;

  const open = () => {
    getModal()?.removeAttribute("hidden");
    getInput()?.focus();
    void ensureFullIndex(); // fire-and-forget 预热
  };
  const close = () => getModal()?.setAttribute("hidden", "");

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (getModal()?.hasAttribute("hidden")) open();
      else close();
    }
    if (e.key === "Escape") close();
  });
  // 顶栏触发器在软导航后是新 DOM —— 事件委托到 document
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest("[data-search-open]");
    if (trigger) {
      e.preventDefault();
      open();
      return;
    }
    if (e.target === getModal()) close();
  });

  // 标题是任意 frontmatter 字符串 —— innerHTML 前必须分段转义（高亮 mark 为自建标签）
  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c,
    );

  const render = () => {
    const el = getResultsEl();
    if (!el) return;
    selected = Math.min(selected, Math.max(0, results.length - 1));
    el.innerHTML = results
      .map((r, i) => {
        const { title, matchStart: s, matchLength: len } = r;
        const html =
          escapeHtml(title.slice(0, s)) +
          `<mark>${escapeHtml(title.slice(s, s + len))}</mark>` +
          escapeHtml(title.slice(s + len));
        // 正文命中附上下文片段（第二行 <mark>），标题命中无 snippet
        const ss = r.snippetStart ?? 0;
        const sl = r.snippetLength ?? 0;
        const snip = r.snippet
          ? `<span class="r-snippet">${escapeHtml(r.snippet.slice(0, ss))}<mark>${escapeHtml(
              r.snippet.slice(ss, ss + sl),
            )}</mark>${escapeHtml(r.snippet.slice(ss + sl))}</span>`
          : "";
        return `
        <li class="result${i === selected ? " selected" : ""}" role="option" aria-selected="${i === selected}" data-i="${i}">
          <span class="r-title">${html}</span>
          ${snip}
          <span class="r-kind">${r.kind === "note" ? "笔记" : "文章"}</span>
        </li>`;
      })
      .join("");
  };

  const go = (r: { url: string }) => {
    close();
    // 与站内其它链接一致走 ClientRouter 软导航，避免整页重载
    navigate(r.url);
  };

  document.addEventListener("input", (e) => {
    if ((e.target as HTMLElement).id !== "search-input") return;
    const query = (e.target as HTMLInputElement).value;
    // 异步：全文索引就绪前先不渲染（首次 fetch 极快），就绪后走全文过滤；
    // 索引加载失败（空数组）则回退内联标题索引——降级路径完整保留
    void (async () => {
      const full = await ensureFullIndex();
      results =
        full.length > 0 ? filterEntriesFullText(full, query) : filterEntries(readIndex(), query);
      selected = 0;
      render();
    })();
  });

  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).id !== "search-input") return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      selected = Math.min(selected + 1, results.length - 1);
      render();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      selected = Math.max(selected - 1, 0);
      render();
    } else if (e.key === "Enter" && results[selected]) {
      go(results[selected]);
    }
  });

  document.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".result");
    if (li && getModal()?.contains(li)) {
      const i = Number(li.dataset.i);
      if (results[i]) go(results[i]);
    }
  });
</script>
