<button id="menu-btn" type="button" aria-label="打开导航菜单" aria-controls="sidebar" aria-expanded="false">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<style>
  #menu-btn {
    display: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text-2);
    cursor: pointer;
  }
  @media (max-width: 1023px) {
    #menu-btn { display: grid; }
  }
</style>

<script>
  // 按钮不在 transition:persist 内，软导航后是新 DOM —— 委托到 document，
  // 每次事件动态查询节点（与 Search.astro 同款模式），并同步 aria-expanded。
  const setOpen = (open: boolean) => {
    document.getElementById("sidebar")?.classList.toggle("open", open);
    document.getElementById("menu-btn")?.setAttribute("aria-expanded", String(open));
  };

  document.addEventListener("click", (e) => {
    const sidebar = document.getElementById("sidebar");
    const btn = (e.target as HTMLElement).closest("#menu-btn");
    if (btn) {
      const open = !sidebar?.classList.contains("open");
      setOpen(Boolean(open));
      return;
    }
    // 点击抽屉外区域关闭
    if (
      sidebar?.classList.contains("open") &&
      !sidebar.contains(e.target as Node)
    ) {
      setOpen(false);
    }
  });
  // Esc 关闭
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
