---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteList from "../../components/NoteList.astro";
import { getAllNotes } from "../../lib/collections";
import { groupNotesByCategory } from "../../lib/notes";

const groups = groupNotesByCategory(await getAllNotes());
const total = groups.reduce((n, g) => n + g.notes.length, 0);
---

<BaseLayout title="笔记" description="嵌入式与硬件基础的学习笔记">
  <section class="notes-page">
    <header class="notes-header">
      <h1>笔记</h1>
      <p class="notes-sub">
        学习路上的碎片积累，共 {total} 篇 · <a href="/notes/graph/">关系图谱</a>
      </p>
    </header>

    {groups.map((g) => (
      <section aria-label={g.label}>
        <h2 class="cat-title">
          <a href={`/notes/${g.category}/`}>{g.label}</a>
          <span class="cat-count">{g.notes.length}</span>
        </h2>
        <NoteList notes={g.notes} />
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .notes-page { padding: 3rem 0; }
  .notes-header { margin-bottom: 2.5rem; }
  .notes-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .notes-sub { color: var(--text-2); }

  .cat-title {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 1.1rem;
    color: var(--text-2);
    font-weight: 600;
    margin: 2.25rem 0 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .cat-count {
    font-size: 0.8rem;
    color: var(--text-3);
    font-weight: 500;
  }
  .cat-title a { color: inherit; }
  .cat-title a:hover { color: var(--accent); }
</style>
