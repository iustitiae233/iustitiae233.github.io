---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteList from "../../components/NoteList.astro";
import { getAllNotes } from "../../lib/collections";
import {
  NOTE_CATEGORY_LABELS,
  NOTE_CATEGORY_VALUES,
  notesInCategory,
  type NoteCategory,
} from "../../lib/notes";

/** 分类页：列表完全由 collection 推导，加笔记不用改这里。
 *  这是各分类的**唯一**索引——原先并存的「分类总览」（<分类>/overview）已删除，
 *  它同时被当成策展文章和索引，导致每加一篇笔记都要回去改手写列表。 */
export function getStaticPaths() {
  return NOTE_CATEGORY_VALUES.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as NoteCategory;
const notes = await getAllNotes();
const list = notesInCategory(notes, category);
const label = NOTE_CATEGORY_LABELS[category];
---

<BaseLayout
  title={`${label}笔记`}
  description={`${label}分类下的全部笔记，共 ${list.length} 篇`}
>
  <section class="cat-page">
    <header class="cat-header">
      <p class="cat-kicker"><a href="/notes/">← 全部笔记</a></p>
      <h1>{label}</h1>
      <p class="cat-sub">
        {list.length} 篇笔记 · <a href="/notes/graph/">关系图谱</a>
      </p>
    </header>
    <NoteList notes={list} />
  </section>
</BaseLayout>

<style>
  .cat-page { padding: 2.5rem 0 3rem; }
  .cat-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--text-3);
  }
  .cat-kicker a { color: var(--accent); }
  .cat-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  .cat-sub { color: var(--text-2); margin-bottom: 1.5rem; }
</style>
