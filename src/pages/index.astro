---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublishedPosts, getAllNotes } from "../lib/collections";
import { topRepos, type RepoLike } from "../lib/projects";
import profile from "../data/github-profile.json";
import repoData from "../data/github-repos.json";

const posts = (await getPublishedPosts()).map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  body: p.body ?? "",
}));

// hero 副标题的篇数必须由 collection 推导，不能写死
const totalNotes = (await getAllNotes()).length;

// 首页项目预览：最近 3 个（排序规则在 src/lib/projects.ts，有 vitest）
const projects = topRepos(repoData.repos as RepoLike[], 3);
---

<BaseLayout title="我的博客" description="嵌入式、硬件电路与 AI 底层原理的学习笔记库">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <!-- 装饰母题：内联 SVG，零网络请求。svg 根元素不是 LCP 候选，里面也没有 <image>，
         所以首屏 LCP 只可能是下面的 <h1> 文本 —— 构造上保证，不靠调优。 -->
    <svg
      class="hero-motif"
      viewBox="0 0 1200 380"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <!-- 数字方波 → 模拟正弦，共端点 (510,54)，linecap:round 让接缝看不出来 -->
        <path
          id="hero-square"
          d="M90 54H120V38H160V70H200V38H240V70H280V38H320V70H360V38H400V70H440V38H470V54H510"
        />
        <path
          id="hero-sine"
          d="M510 54C530 33 550 33 570 54C590 75 610 75 630 54C650 33 670 33 690 54C710 75 730 75 750 54C770 33 790 33 810 54C830 75 850 75 870 54C890 33 910 33 930 54C950 75 970 75 990 54C1010 33 1030 33 1050 54C1070 75 1090 75 1110 54"
        />
      </defs>

      <!-- 上带：信号链 -->
      <use class="m-trace" href="#hero-square"></use>
      <use class="m-signal" href="#hero-sine"></use>

      <!-- 下带：PCB 总线（45° 折弯是布线惯例），中间留缺口暗示此处有元件 -->
      <path class="m-trace" d="M60 355V330H260L290 300H520"></path>
      <path class="m-trace" d="M680 300H900L930 330H1140V355"></path>

      <!-- 铺铜区 -->
      <rect class="m-region" x="966" y="14" width="124" height="66" rx="10"></rect>
      <rect class="m-region" x="26" y="300" width="150" height="66" rx="10"></rect>

      <!-- 焊盘 / 过孔 -->
      <circle class="m-pad" cx="60" cy="355" r="5"></circle>
      <circle class="m-pad" cx="1140" cy="355" r="5"></circle>
      <circle class="m-pad" cx="520" cy="300" r="4"></circle>
      <circle class="m-pad" cx="680" cy="300" r="4"></circle>
      <circle class="m-via" cx="510" cy="54" r="3"></circle>
      <circle class="m-via" cx="290" cy="300" r="2.5"></circle>
      <circle class="m-via" cx="930" cy="330" r="2.5"></circle>

      <!-- 信号包：同一条正弦再叠两遍（粗淡当光晕、细亮当包本体，不用 filter） -->
      <use class="m-flow-glow" href="#hero-sine"></use>
      <use class="m-flow" href="#hero-sine"></use>
    </svg>

    <div class="hero-copy">
      <p class="hero-hi">你好，我是 {profile.name}</p>
      <h1>嵌入式 · 硬件电路 · AI 底层原理</h1>
      <p class="hero-sub">{totalNotes} 篇从零学起的学习笔记，持续更新中</p>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="home-projects" aria-label="项目">
      <h2 class="section-title">
        项目
        <a class="section-more" href="/projects/">全部项目 →</a>
      </h2>
      <div class="grid">
        {projects.map((r, i) => (
          <div class="cell reveal" style={`--reveal-delay: ${(i * 60).toString()}ms;`}>
            <ProjectCard repo={r} headingLevel="h3" />
          </div>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section aria-label="文章列表">
      <h2 class="section-title">文章</h2>
      <div class="grid">
        {posts.map((p, i) => (
          <div class="cell" style={`--reveal-delay: ${(i * 60).toString()}ms;`}>
            <PostCard {...p} />
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    /* 不加 overflow: hidden —— hero-glow 的 top:-40% 是有意外溢的，裁掉会变样 */
    position: relative;
    padding: 5rem 0 4.5rem;
    text-align: center;
  }
  .hero-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: min(680px, 90%);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--accent-glow), transparent);
    filter: blur(60px);
    opacity: 0.6;
    pointer-events: none;
  }
  /* 注意：hero 内的文字块刻意不加 .reveal —— .reveal 初始 opacity: 0，
     而 opacity 为 0 的元素不计入 LCP，指标要等过渡结束才登记。
     装饰层也不参与 LCP（见模板注释）。 */

  .hero-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0; /* hero-glow 无 z-index 且 DOM 在前 → 光斑在下、走线在上 */
    pointer-events: none; /* 不吞任何点击 / 文本选择 */
    opacity: 0.55;
    /* 兜底：SVG 的 fill 初始值是 black，漏写规则就是一团黑块。
       fill 是可继承属性，这里声明一次就传进 <use> 的影子树。 */
    fill: none;
  }
  /* 色值全走设计令牌 + color-mix → 亮色主题自动跟随，不需要第二套规则。 */
  .hero-motif .m-trace {
    stroke: color-mix(in srgb, var(--accent) 55%, transparent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-motif .m-signal {
    stroke: color-mix(in srgb, var(--accent-2) 70%, transparent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-motif .m-region { fill: color-mix(in srgb, var(--accent) 5%, transparent); }
  .hero-motif .m-pad {
    fill: var(--surface);
    stroke: color-mix(in srgb, var(--accent) 65%, transparent);
    stroke-width: 1.5;
  }
  .hero-motif .m-via { fill: color-mix(in srgb, var(--accent-3) 85%, transparent); }

  /* 信号包：dasharray 的周期 742 == 动画位移 742 → 循环无缝（742 是自身整数倍，
     与路径实长无关）。粗而淡的一层当光晕、细而亮的一层当包本体，不用 filter。 */
  .hero-motif .m-flow,
  .hero-motif .m-flow-glow {
    stroke-linecap: round;
    stroke-dasharray: 44 698;
  }
  .hero-motif .m-flow-glow {
    stroke: color-mix(in srgb, var(--accent) 35%, transparent);
    stroke-width: 6;
  }
  .hero-motif .m-flow {
    stroke: var(--accent);
    stroke-width: 1.75;
  }

  @keyframes hero-signal-flow {
    from { stroke-dashoffset: 742; }
    to { stroke-dashoffset: 0; }
  }

  /* 只在「未要求减少动效」时挂上动画：这样根本不存在需要覆盖的规则，
     直接绕开「reduced-motion 覆盖选择器写不全就是空操作」那个老坑。 */
  @media (prefers-reduced-motion: no-preference) {
    .hero-motif .m-flow,
    .hero-motif .m-flow-glow {
      animation: hero-signal-flow 6s linear infinite;
    }
  }

  /* 窄屏：3.16:1 的构图会被压成一条正好压在标题上的窄带 —— 干脆不画，
     顺带省掉手机上每帧的合成开销。 */
  @media (max-width: 767px) {
    .hero-motif { display: none; }
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-hi {
    color: var(--text-2);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .hero-sub {
    color: var(--text-2);
    max-width: 34em;
    margin-inline: auto;
  }

  .home-projects { margin-bottom: 3.5rem; }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 1.1rem;
    color: var(--text-2);
    font-weight: 600;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .section-more {
    margin-left: auto; /* section-title 是 flex —— 入口贴右端的分隔线上方 */
    font-size: 0.8rem;
    font-weight: 500;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .cell { display: grid; }
</style>
