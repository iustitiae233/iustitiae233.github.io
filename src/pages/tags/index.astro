---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllNotes } from "../../lib/collections";
import { collectTags, tagUrl } from "../../lib/tags";

const tags = collectTags(await getAllNotes());
---

<BaseLayout title="标签" description="笔记标签索引">
  <section class="tags-page">
    <header class="tags-header">
      <h1>标签</h1>
      <p class="tags-sub">知识的另一个切面，共 {tags.length} 个标签</p>
    </header>

    {tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map((t) => (
          <li>
            <a class="tag-chip" href={tagUrl(t.tag)}>
              {t.tag}
              <span class="tag-count">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="tags-empty">还没有笔记带标签 —— 在笔记 frontmatter 写 <code>tags: [标签A, 标签B]</code> 即可。</p>
    )}
  </section>
</BaseLayout>

<style>
  .tags-page { padding: 3rem 0; }
  .tags-header { margin-bottom: 2rem; }
  .tags-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .tags-sub { color: var(--text-2); }
  .tag-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-1);
    font-size: 0.92rem;
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }
  .tag-chip:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .tag-count {
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .tags-empty { color: var(--text-2); }
  .tags-empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }
</style>
